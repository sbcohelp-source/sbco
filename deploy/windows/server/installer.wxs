<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="SBCO Server" Language="1033" Version="0.1.0" Manufacturer="S K Singh" UpgradeCode="126a311d-74cf-4427-9422-12b3182ea43e">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" Description="SBCO HTTPS office server" Comments="Support: sbcohelp@gmail.com" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer SBCO Server is installed." Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="ARPCONTACT" Value="S K Singh" />
    <Property Id="ARPHELPLINK" Value="mailto:sbcohelp@gmail.com" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/sbcohelp-source/sbco" />
    <Property Id="ARPPRODUCTICON" Value="SBCOIcon" />
    <Property Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" />
    <Icon Id="SBCOIcon" SourceFile="$(var.AppIcon)" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />
    <UIRef Id="WixUI_Minimal" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder"><Directory Id="INSTALLFOLDER" Name="SBCO Server" /></Directory>
      <Directory Id="ProgramMenuFolder"><Directory Id="SBCOMenu" Name="SBCO Server" /></Directory>
    </Directory>
    <DirectoryRef Id="SBCOMenu">
      <Component Id="ServerShortcut" Guid="*" Win64="yes">
        <Shortcut Id="ConfigureShortcut" Name="Configure SBCO Server" Description="Set up HTTPS and the first administrator, or resume the existing server" Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe" Arguments="-NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]server\Configure-Server.ps1&quot;" WorkingDirectory="INSTALLFOLDER" Icon="SBCOIcon" />
        <RegistryValue Root="HKLM" Key="Software\S K Singh\SBCO Server" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveServerMenu" On="uninstall" />
      </Component>
    </DirectoryRef>
    <Feature Id="Server" Title="SBCO Server" Level="1"><ComponentGroupRef Id="ServerPayload" /><ComponentRef Id="ServerShortcut" /></Feature>
    <!-- No MSI property contains a database password or application password. -->
    <CustomAction Id="StopOwnedServices" Directory="INSTALLFOLDER" ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]server\Manage-Services.ps1&quot; -Action Stop" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RemoveOwnedServices" Directory="INSTALLFOLDER" ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]server\Manage-Services.ps1&quot; -Action Remove" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="ResumeOwnedServices" Directory="INSTALLFOLDER" ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]server\Manage-Services.ps1&quot; -Action Resume" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="RollbackResumeServices" Directory="INSTALLFOLDER" ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]server\Manage-Services.ps1&quot; -Action Resume" Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="RollbackStopServices" Directory="INSTALLFOLDER" ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]server\Manage-Services.ps1&quot; -Action Stop" Execute="rollback" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RollbackResumeServices" Before="StopOwnedServices">Installed</Custom>
      <Custom Action="StopOwnedServices" Before="RemoveOwnedServices">Installed</Custom>
      <Custom Action="RemoveOwnedServices" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="RollbackStopServices" Before="ResumeOwnedServices">NOT REMOVE="ALL"</Custom>
      <Custom Action="ResumeOwnedServices" After="InstallFiles">NOT REMOVE="ALL"</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
