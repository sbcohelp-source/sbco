FROM rust:1.99.1-slim-bookworm AS build
WORKDIR /src
ENV CARGO_BUILD_JOBS=2
COPY Cargo.toml Cargo.lock rust-toolchain.toml LICENSE ./
COPY crates crates
COPY migrations migrations
RUN cargo build --release --locked -p sbco-api -p sbco-worker
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/* && useradd --system --uid 10001 sbco
COPY --from=build /src/target/release/sbco-api /src/target/release/sbco-worker /usr/local/bin/
COPY --from=build /src/crates/documents/fonts/LICENSE.txt /usr/share/doc/sbco/Noto-OFL.txt
USER sbco
ENV SBCO_BIND=0.0.0.0:8091
CMD ["sbco-api"]
