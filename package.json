{
  "name": "sbco-next",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "dev": "yarn workspace @sbco/web dev",
    "build:web": "yarn workspace @sbco/web build",
    "build:desktop-ui": "yarn workspace @sbco/web build:desktop",
    "typecheck": "yarn workspace @sbco/web typecheck",
    "lint": "eslint apps/web/src packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/client.test.mjs",
    "test:e2e": "playwright test",
    "test:acceptance": "playwright test --config playwright.acceptance.config.ts",
    "desktop": "cd apps/desktop && tauri dev",
    "desktop:build": "cd apps/desktop && tauri build",
    "check:contracts": "bash scripts/check-contracts.sh",
    "start": "bash scripts/start-web.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.23.0",
    "typescript": "6.0.3"
  },
  "author": {
    "name": "S K Singh",
    "email": "sbcohelp@gmail.com"
  }
}
